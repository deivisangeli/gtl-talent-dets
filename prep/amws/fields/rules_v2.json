{
  "version": "amws_ed16_science_v2",
  "policy": "Broad Physical includes all engineering, statistics and computing; Biological chemistry/biochemistry/biophysics alone remain Biological. Explicit mixed fields count as Physical.",
  "specific_rules": [
    {
      "id": "P_BIO_ENGINEERING_STATS",
      "groups": [
        "physical_science",
        "biological_science"
      ],
      "pattern": "\\b(?:BIO\\s*(?:MEDICAL\\s+)?ENGINEERING|BIO\\s*STATISTICS|BIOMETRY|BIOMETEOROLOGY)\\b"
    },
    {
      "id": "P_ECONOMIC_STATS",
      "group": "physical_science",
      "pattern": "\\bECONOMIC\\s+STATISTICS\\b"
    },
    {
      "id": "B_COMPOUND",
      "group": "biological_science",
      "pattern": "\\b(?:BIO\\s*(?:CHEM(?:ISTRY|ICAL)|PHYSICS|PHYSICAL(?:\\s+CHEMISTRY)?)|(?:IMMUNO|NEURO|PHYSIOLOGICAL)\\s*CHEMISTRY|(?:MEDICINAL|PHARMACEUTICAL|CLINICAL|BIOLOGICAL)\\s+CHEMISTRY|(?:PHYSICAL|BIOLOGICAL)\\s+ANTHROPOLOGY)\\b"
    },
    {
      "id": "O_SOCIAL_COMPOUND",
      "group": "other",
      "pattern": "\\b(?:(?:AGRICULTURAL|FOREST|RESOURCE)\\s+ECONOMICS|(?:VISUAL\\s+)?PSYCHOPHYSICS|(?:HISTORY|PHILOSOPHY)\\s+OF\\s+(?:SCIENCE|PHYSICS|CHEMISTRY|MATHEMATICS)|TECHNOLOGICAL\\s+INNOVATION|NEW\\s+VENTURES)\\b"
    }
  ],
  "general_rules": [
    {
      "id": "B_LIFE",
      "group": "biological_science",
      "pattern": "\\b(?:BIOLOGY|BIOLOGICAL|BOTANY|ZOOLOGY|OOLOGY|ECOLOGY|PALEOECOLOGY|PALEOBIOLOGY|ENTOMOLOGY|MICROBIOLOGY|BACTERIOLOGY|VIROLOGY|PARASITOLOGY|MYCOLOGY|GENETICS|CYTOLOGY|EMBRYOLOGY|MORPHOLOGY|PHYSIOLOGY|PHOTOBIOLOGY|ENZYMOLOGY|LIMNOLOGY|NEUROBIOLOGY|NEUROCHEMISTRY|NEUROPHYSIOLOGY|IMMUNOLOGY|NEUROIMMUNOLOGY|IMMUNOCHEMISTRY)\\b"
    },
    {
      "id": "B_MEDICAL",
      "group": "biological_science",
      "pattern": "\\b(?:MEDICINE|MEDICAL|VETERINARY|PATHOLOGY|PHYTOPATHOLOGY|PHARMACOLOGY|IMMUNOPHARMACOLOGY|NEUROPHARMACOLOGY|CHEMOTHERAPY|ENDOCRINOLOGY|HEMATOLOGY|ONCOLOGY|TOXICOLOGY|TERATOLOGY|EPIDEMIOLOGY|SURGERY|NEUROSURGERY|PSYCHIATRY|NEUROPSYCHIATRY|RADIOLOGY|DERMATOLOGY|PEDIATRICS|NEPHROLOGY|OBSTETRICS|GYNECOLOGY|AUDIOLOGY|ALLERGY|ANATOMY|NUTRITION|METABOLISM|PUBLIC\\s+HEALTH|COMMUNITY\\s+HEALTH|ENVIRONMENTAL\\s+HEALTH|OCCUPATIONAL\\s+HEALTH|CLINICAL\\s+PSYCHOLOGY)\\b"
    },
    {
      "id": "B_AGRICULTURAL",
      "group": "biological_science",
      "pattern": "\\b(?:AGRICULTURE|AGRONOMY|HORTICULTURE|FORESTRY|FOREST\\s+SOILS|SOIL\\s+SCIENCE|PLANT\\s+(?:BREEDING|NUTRITION)|POULTRY\\s+SCIENCE|DAIRY\\s+SCIENCE|FOOD\\s+(?:SCIENCE|TECHNOLOGY)|ENOLOGY|FISHERIES|WILDLIFE|CORAL\\s+REEF|ANIMAL\\s+BEHAVI[O]?UR|ANIMAL\\s+BEHAVIOR)\\b"
    },
    {
      "id": "P_CHEMISTRY",
      "group": "physical_science",
      "pattern": "\\b(?:CHEMISTRY|ORGANIC\\s*CHEMISTRY|GEOCHEMISTRY|SPECTROCHEMISTRY|ELECTROCHEMISTRY|PHOTOCHEMISTRY|POLYMER\\s+SCIENCE|MASS\\s+SPECTROMETRY|SPECTROSCOPY)\\b"
    },
    {
      "id": "P_PHYSICS",
      "group": "physical_science",
      "pattern": "\\b(?:PHYSICS|ASTROPHYSICS|ASTRONOMY|OPTICS|OPTICAL\\s+PROPERTIES|ELECTRONICS|ELECTRODYNAMICS|ELECTROMAGNETISM|THERMODYNAMICS|HYDRODYNAMICS|ACOUSTICS|MECHANICS|SEMICONDUCTORS|CIRCUITS|MATERIALS\\s+SCIENCE|SPACE\\s+SCIENCES?|NUCLEAR\\s+MAGNETIC\\s+RESONANCE|HOLOGRAPHIC\\s+INTERFEROMETRY)\\b"
    },
    {
      "id": "P_EARTH",
      "group": "physical_science",
      "pattern": "\\b(?:GEOLOGY|GEOPHYSICS|GEOMORPHOLOGY|MINERALOGY|PETROLOGY|SEISMOLOGY|METEOROLOGY|CLIMATOLOGY|OCEANOGRAPHY|HYDROLOGY|SEDIMENTATION|STRATIGRAPHY|BASIN\\s+ANALYSIS|SLOPE\\s+STABILITY|PHOTOGRAMMETRY|GEODESY)\\b"
    },
    {
      "id": "P_ENGINEERING",
      "group": "physical_science",
      "pattern": "\\b(?:ENGINEERING|METALLURGY|PROCESS\\s+(?:DEVELOPMENT|RESEARCH)|PLANT\\s+DESIGN)\\b"
    },
    {
      "id": "P_MATH_COMPUTING",
      "group": "physical_science",
      "pattern": "\\b(?:MATHEMATICS|MATHEMATICAL|STATISTICS|ALGEBRA|GEOMETRY|TOPOLOGY|COMBINATORICS|COMPUTER\\s+(?:SCIENCE|PERFORMANCE)|COMPUTING|NUMERICAL\\s+ANALYSIS|(?:INTEGRAL|DIFFERENTIAL)\\s+E[QO]UAT[I1L]ONS|OPERATIONS\\s+(?:RESEARCH|ANALYSIS)|SYMBOLIC\\s+LOGIC)\\b"
    },
    {
      "id": "O_NON_TARGET",
      "group": "other",
      "pattern": "\\b(?:PSYCHOLOGY|PSYCHOPHYSICS|SOCIOLOGY|ECONOMICS|ANTHROPOLOGY|EDUCATION|SCIENCE\\s+COMMUNICATIONS?|PUBLIC\\s+POLICY|ADMINISTRATION|CORPORATE\\s+PLANNING|FUTURES\\s+RESEARCH|TECHNOLOGICAL\\s+INNOVATION)\\b"
    },
    {
      "id": "P_SPECIALTY_PHYSICS",
      "group": "physical_science",
      "pattern": "\\b(?:ELECTROMAGNETIC\\s+THEORY|SCATTERING\\s+THEORY|FLUID\\s+DYNAMICS|SOLAR\\s+ENERGY|ASTRODYNAMICS|RADIATION\\s+PRESSURE(?:\\s+EFFECTS)?|ELECTRICAL\\s+INSULATION|DIELECTRICS|AEROSOL\\s+SCIENCE|X\\s+RAY\\s+CRYSTALLOGRAPHY|STATIC\\s+MAGNETIC\\s+FIELD\\s+ANALYSIS)\\b"
    },
    {
      "id": "P_SPECIALTY_EARTH",
      "group": "physical_science",
      "pattern": "\\b(?:PALEONTOLOGY|BIOSTRATIGRAPHY|PHYSICAL\\s+GEOGRAPHY)\\b"
    },
    {
      "id": "P_SPECIALTY_ENGINEERING",
      "group": "physical_science",
      "pattern": "\\b(?:INDUSTRIAL\\s+CHEMICALS|(?:CONTINUOUS\\s+)?CHEMICAL\\s+REACTOR\\s+DESIGN|REFINERY\\s+PROCESS\\s+DESIGN|PILOT\\s+PLANTS|CARBON\\s+BLACK|RUBBER\\s+FILLERS|CONTROL\\s+SYSTEMS|METAL\\s+CUTTING)\\b"
    },
    {
      "id": "P_SPECIALTY_COMPUTING",
      "group": "physical_science",
      "pattern": "\\b(?:EXPERT\\s+SYSTEMS|IMAGE\\s+PROCESSING|(?:HANDICAPPED\\s+)?COMPUTER\\s+(?:COMMUNICATIONS?\\s+)?AIDS)\\b"
    }
  ],
  "ocr_join_words": [
    "PHYSICS",
    "ASTRONOMY",
    "ASTROPHYSICS",
    "CHEMISTRY",
    "BIOCHEMISTRY",
    "BIOPHYSICS",
    "BIOLOGICAL",
    "ENGINEERING",
    "MATHEMATICS",
    "STATISTICS",
    "METALLURGY"
  ],
  "ocr_aliases": {
    "ASTROPOHYSICS": "ASTROPHYSICS",
    "BJOCHEMISTRY": "BIOCHEMISTRY"
  }
}
